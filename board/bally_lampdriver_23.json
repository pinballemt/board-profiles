{
  "board_id": "bally_as-2518-23_lamp_driver",
  "description": "Bally lamp driver board: J4 MPU interface, J1–J3 lamp headers, U1–U4 MC14514 decoders, transistor mapping",

  "connectors": [
    {
      "id": "J4",
      "role": "mpu_interface",
      "description": "Lamp address, lamp data, strobe, and utility/test signals from MPU",
      "pins": [
        {
          "pin": 1,
          "signal": "J4_P1",
          "alias": "+5V_MON",
          "direction": "reference",
          "goes_to": [
            { "type": "test_point", "ref": "TP1", "note": "+5V ±0.25 VDC monitor" }
          ],
          "notes": "Utility bus node associated with +5V monitoring"
        },
        {
          "pin": 2,
          "signal": "J4_P2",
          "alias": "GND_REF",
          "direction": "reference",
          "goes_to": [
            { "type": "test_point", "ref": "TP2", "note": "GND reference" }
          ],
          "notes": "Utility bus node tied to ground reference"
        },
        {
          "pin": 3,
          "signal": "J4_P3",
          "alias": "+5V_REF",
          "direction": "reference",
          "goes_to": [
            { "type": "test_point", "ref": "TP3" },
            { "type": "resistor", "ref": "R70", "value": "2K" },
            { "type": "capacitor", "ref": "C1", "value": "0.01uF", "to": "GND" }
          ],
          "notes": "Filtered +5V reference node (R70 to +5V, C1 to GND)"
        },
        {
          "pin": 4,
          "signal": "PD3_LAMP_DATA",
          "direction": "input",
          "goes_to": [
            { "type": "resistor", "ref": "R65", "value": "2.2M" },
            { "type": "bus", "ref": "LAMP_DATA[3]" }
          ],
          "notes": "Lamp data bit 3 from MPU; through R65 into MC14514 data path"
        },
        {
          "pin": 5,
          "signal": "PD2_LAMP_DATA",
          "direction": "input",
          "goes_to": [
            { "type": "resistor", "ref": "R64", "value": "2.2M" },
            { "type": "bus", "ref": "LAMP_DATA[2]" }
          ],
          "notes": "Lamp data bit 2 from MPU; through R64 into MC14514 data path"
        },
        {
          "pin": 6,
          "signal": "PD1_LAMP_DATA",
          "direction": "input",
          "goes_to": [
            { "type": "resistor", "ref": "R63", "value": "2.2M" },
