        {
          "pin": 7,
          "signal": "PD0_LAMP_DATA",
          "direction": "input",
          "goes_to": [
            { "type": "resistor", "ref": "R62", "value": "2.2M" },
            { "type": "bus", "ref": "LAMP_DATA[0]" }
          ],
          "notes": "Lamp data bit 0 from MPU; through R62 into MC14514 data path"
        },
        {
          "pin": 8,
          "signal": "KEY",
          "direction": "none",
          "goes_to": [],
          "notes": "Key position; mechanical only, no contact"
        },
        {
          "pin": 9,
          "signal": "SPARE1",
          "direction": "unused",
          "goes_to": [],
          "notes": "Marked SPARE on schematic; no functional connection"
        },
        {
          "pin": 10,
          "signal": "SPARE2",
          "direction": "unused",
          "goes_to": [],
          "notes": "Marked SPARE on schematic; no functional connection"
        },
        {
          "pin": 11,
          "signal": "J4_P11",
          "direction": "reference",
          "goes_to": [
            { "type": "net_group", "ref": "J4_UTILITY_BUS" }
          ],
          "notes": "Unlabeled tap on same utility cluster as TP1/TP2/TP3 (exact MPU use TBD)"
        },
        {
          "pin": 12,
          "signal": "J4_P12",
          "direction": "reference",
          "goes_to": [
