    "changelog": [
      "v1.0 (2026-04-30): Initial build from manual solenoid/lamp/switch tables. Sound commands stubbed pending ROM analysis."
    ],
    "diagnostic_notes": [
      "Machine exhibits spontaneous mid-game resets. Prime suspects: Sol13 (Mystery Wheel coil B), Sol14 (Mystery Wheel coil A), Sol16 (Ferris Wheel motor relay). Monitor should log solenoid activity immediately preceding each RESET event.",
      "Mystery Wheel position tracked via 16 lamp positions (lamps 33-48, 22.5-degree increments) plus SW41 (Home opto). Mechanism requires both coil A and coil B for stepper control.",
      "Ferris Wheel motor (Sol16) is a continuous-run relay -- monitor will see sustained Sol16 activity during Ferris Wheel sequences."
    ]
  },
  "switch_matrix": {
    "rows": 8,
    "columns": 8,
    "notes": [
      "Williams System 11A switch numbering: column-major order. SW1-8=Col1, SW9-16=Col2, etc.",
      "Column strobe transistors on D-11392 board. Row return lines via 1J10 connector.",
      "Gate Lane switches SW14-16 (1/2/3 lanes) in Col2.",
      "Shuttle value switches SW26-30 in Col4 -- note two separate 25K entries (top and bottom positions).",
      "Mystery Wheel Home Opto SW41 in Col6 Row1 -- optical sensor, not mechanical.",
      "SW53-54 (Left/Right Outlane Ex.Ball) in Col7 rows 5-6.",
      "SW57-58 (Lane Change flipper buttons) in Col8 rows 1-2 -- in switch matrix unlike EOS switches."
    ],
